{
  "id": "recruitment-erp",
  "realm": "recruitment-erp",
  "enabled": true,
  "loginTheme": "recruitment-erp",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 900,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyInitialCounter": 0,
  "otpPolicyLookAheadWindow": 1,
  "roles": {
    "realm": [
      {
        "name": "SUPER_ADMIN",
        "description": "Platform-level administrator"
      },
      {
        "name": "TENANT_ADMIN",
        "description": "Tenant-level administrator"
      },
      {
        "name": "BRANCH_MANAGER",
        "description": "Branch-level manager"
      },
      {
        "name": "RECRUITER",
        "description": "Standard recruiter"
      },
      {
        "name": "COMPLIANCE_OFFICER",
        "description": "Compliance/document verification"
      },
      {
        "name": "FINANCE_OFFICER",
        "description": "Billing/finance"
      },
      {
        "name": "CLIENT_USER",
        "description": "Client portal user (employer)"
      },
      {
        "name": "CANDIDATE",
        "description": "Candidate portal user"
      }
    ]
  },
  "groups": [
    {
      "name": "staff-mfa-required",
      "realmRoles": [
        "SUPER_ADMIN",
        "TENANT_ADMIN",
        "BRANCH_MANAGER",
        "RECRUITER",
        "COMPLIANCE_OFFICER",
        "FINANCE_OFFICER"
      ]
    },
    {
      "name": "external-no-mfa",
      "realmRoles": [
        "CLIENT_USER",
        "CANDIDATE"
      ]
    }
  ],
  "authenticationFlows": [
    {
      "alias": "browser-with-conditional-otp",
      "description": "Browser flow with conditional OTP for staff roles",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10
        },
        {
          "authenticator": "auth-spnego",
          "authenticatorFlow": false,
          "requirement": "DISABLED",
          "priority": 20
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "flowAlias": "browser-with-conditional-otp forms"
        }
      ]
    },
    {
      "alias": "browser-with-conditional-otp forms",
      "description": "Username/password and conditional OTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "browser-with-conditional-otp Conditional OTP"
        }
      ]
    },
    {
      "alias": "browser-with-conditional-otp Conditional OTP",
      "description": "OTP required for staff roles only",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "staff-role-condition-super-admin"
        },
        {
          "authenticator": "conditional-user-configured",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 15
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "staff-role-condition-super-admin",
      "config": {
        "conditionUserRole": "SUPER_ADMIN",
        "negate": "false"
      }
    },
    {
      "alias": "staff-role-condition-tenant-admin",
      "config": {
        "conditionUserRole": "TENANT_ADMIN",
        "negate": "false"
      }
    },
    {
      "alias": "staff-role-condition-branch-manager",
      "config": {
        "conditionUserRole": "BRANCH_MANAGER",
        "negate": "false"
      }
    },
    {
      "alias": "staff-role-condition-recruiter",
      "config": {
        "conditionUserRole": "RECRUITER",
        "negate": "false"
      }
    },
    {
      "alias": "staff-role-condition-compliance-officer",
      "config": {
        "conditionUserRole": "COMPLIANCE_OFFICER",
        "negate": "false"
      }
    },
    {
      "alias": "staff-role-condition-finance-officer",
      "config": {
        "conditionUserRole": "FINANCE_OFFICER",
        "negate": "false"
      }
    }
  ],
  "browserFlow": "browser-with-conditional-otp",
